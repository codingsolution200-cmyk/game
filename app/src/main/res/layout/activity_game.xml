<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0A1E">

    <!-- ══════════ TOP BAR ══════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#13132F"
        android:paddingTop="20dp"
        android:paddingBottom="14dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:elevation="8dp">

        <TextView
            android:id="@+id/tvCurrentPlayer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎯 Player 1's Turn"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:letterSpacing="0.04"/>

        <View
            android:layout_width="56dp"
            android:layout_height="3dp"
            android:layout_gravity="center"
            android:layout_marginTop="7dp"
            android:background="#6366F1"/>

        <TextView
            android:id="@+id/tvDiceResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tap Roll Dice to Start!"
            android:textColor="#F59E0B"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="8dp"/>

    </LinearLayout>

    <!-- ══════════ BOARD ══════════ -->
    <com.example.game.presentation.ui.game.BoardView
        android:id="@+id/boardView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_margin="10dp"/>

    <!-- ══════════ BOTTOM PANEL ══════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#13132F"
        android:paddingTop="16dp"
        android:paddingBottom="10dp"
        android:elevation="10dp">

        <!-- Dice + Button Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:gravity="center_vertical">

            <!-- Premium Dice Card -->
            <FrameLayout
                android:layout_width="82dp"
                android:layout_height="82dp"
                android:layout_marginEnd="16dp"
                android:elevation="8dp">

                <!-- Glowing border background -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/dice_card_bg"/>

                <!-- Dice Emoji -->
                <TextView
                    android:id="@+id/tvDiceFace"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="⚀"
                    android:textSize="48sp"
                    android:gravity="center"
                    android:textColor="#FFFFFF"
                    android:paddingBottom="4dp"/>

            </FrameLayout>

            <!-- Roll Button -->
            <Button
                android:id="@+id/btnRollDice"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:text="🎲  ROLL DICE"
                android:textSize="17sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:backgroundTint="#6366F1"
                android:textColor="#FFFFFF"
                android:stateListAnimator="@null"
                android:elevation="6dp"/>

        </LinearLayout>

        <!-- Banner Ad -->
        <com.google.android.gms.ads.AdView
            android:id="@+id/adView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"

            android:layout_marginTop="12dp"
            ads:adSize="BANNER"
            ads:adUnitId="ca-app-pub-3940256099942544/6300978111"/>

    </LinearLayout>

</LinearLayout>