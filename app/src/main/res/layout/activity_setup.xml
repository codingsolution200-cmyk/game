<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A1E"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- Back Button -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:background="@android:color/transparent"
            android:layout_gravity="start"
            android:layout_marginBottom="16dp"/>

        <!-- Game Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🐍"
            android:textSize="56sp"
            android:gravity="center"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SAP SIDI"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:gravity="center"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Snakes &amp; Ladders"
            android:textColor="#6366F1"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="32dp"/>

        <!-- Player Count Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#12122E"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NUMBER OF PLAYERS"
                android:textColor="#9CA3AF"
                android:textSize="12sp"
                android:letterSpacing="0.1"
                android:layout_marginBottom="16dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <ImageButton
                    android:id="@+id/btnMinus"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:backgroundTint="#6366F1"
                    android:src="@android:drawable/ic_input_delete"
                    android:background="@android:color/transparent"
                    android:padding="12dp"/>
                <TextView
                    android:id="@+id/tvPlayerCount"
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:text="2"
                    android:textColor="#FFFFFF"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    android:gravity="center"/>

                <ImageButton
                    android:id="@+id/btnPlus"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@android:drawable/ic_input_add"
                    android:backgroundTint="#6366F1"
                    android:padding="12dp"/>

            </LinearLayout>
        </LinearLayout>

        <!-- Player Names Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#12122E"
            android:padding="20dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PLAYER NAMES"
                android:textColor="#9CA3AF"
                android:textSize="12sp"
                android:letterSpacing="0.1"
                android:layout_marginBottom="16dp"/>

            <!-- Player 1 -->
            <TextView
                android:id="@+id/labelPlayer1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔴 Player 1"
                android:textColor="#EF4444"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>
            <EditText
                android:id="@+id/etPlayer1"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Enter name..."
                android:textColorHint="#4B5563"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:background="#1E1E50"
                android:paddingHorizontal="12dp"
                android:inputType="textPersonName"
                android:layout_marginBottom="12dp"/>

            <!-- Player 2 -->
            <TextView
                android:id="@+id/labelPlayer2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🟡 Player 2"
                android:textColor="#F59E0B"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>
            <EditText
                android:id="@+id/etPlayer2"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Enter name..."
                android:textColorHint="#4B5563"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:background="#1E1E50"
                android:paddingHorizontal="12dp"
                android:inputType="textPersonName"
                android:layout_marginBottom="12dp"/>

            <!-- Player 3 -->
            <TextView
                android:id="@+id/labelPlayer3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🟢 Player 3"
                android:textColor="#22C55E"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone"
                android:layout_marginBottom="4dp"/>
            <EditText
                android:id="@+id/etPlayer3"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Enter name..."
                android:textColorHint="#4B5563"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:background="#1E1E50"
                android:paddingHorizontal="12dp"
                android:inputType="textPersonName"
                android:visibility="gone"
                android:layout_marginBottom="12dp"/>

            <!-- Player 4 -->
            <TextView
                android:id="@+id/labelPlayer4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🟣 Player 4"
                android:textColor="#A855F7"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone"
                android:layout_marginBottom="4dp"/>
            <EditText
                android:id="@+id/etPlayer4"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Enter name..."
                android:textColorHint="#4B5563"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:background="#1E1E50"
                android:paddingHorizontal="12dp"
                android:inputType="textPersonName"
                android:visibility="gone"/>

        </LinearLayout>

        <!-- Start Game Button -->
        <Button
            android:id="@+id/btnStartGame"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="▶  START GAME"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:backgroundTint="#6366F1"
            android:textColor="#FFFFFF"
            android:stateListAnimator="@null"
            android:elevation="6dp"/>

    </LinearLayout>
</ScrollView>