<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_gradient">

    <!-- ════════════════════════════════════════
         MAIN CONTENT
    ════════════════════════════════════════ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Floating particles (animated via code) -->
        <View android:id="@+id/particle1"
            android:layout_width="10dp" android:layout_height="10dp"
            android:background="@drawable/circle_player"
            android:alpha="0.18"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="90dp"
            android:layout_marginStart="32dp"/>

        <View android:id="@+id/particle2"
            android:layout_width="6dp" android:layout_height="6dp"
            android:background="@drawable/circle_player"
            android:alpha="0.12"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="160dp"
            android:layout_marginEnd="48dp"/>

        <View android:id="@+id/particle3"
            android:layout_width="8dp" android:layout_height="8dp"
            android:background="@drawable/circle_player"
            android:alpha="0.10"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="260dp"
            android:layout_marginStart="16dp"/>

        <!-- Settings Icon — top right (starts invisible) -->
        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_preferences"
            android:background="@drawable/circle_player"
            android:padding="10dp"
            android:contentDescription="Settings"
            android:alpha="0.0"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="20dp"/>

        <!-- App Title (starts invisible) -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="52sp"
            android:textStyle="bold"
            android:fontFamily="@font/baloo2"
            android:textColor="#FFFFFF"
            android:shadowColor="#44000000"
            android:shadowDx="0"
            android:shadowDy="4"
            android:shadowRadius="12"
            android:alpha="0.0"
            android:letterSpacing="-0.01"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="72dp"/>

        <!-- Subtitle (starts invisible) -->
        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choose Your Game Mode"
            android:textSize="15sp"
            android:fontFamily="@font/baloo2"
            android:textColor="#BDFFFFFF"
            android:letterSpacing="0.12"
            android:alpha="0.0"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="4dp"/>

        <!-- ─── ROW 1: Local Game (wide) ─── -->
        <Button
            android:id="@+id/btnLocalGame"
            android:layout_width="0dp"
            android:layout_height="110dp"
            android:text="🎲  Local Game"
            android:textSize="18sp"
            android:fontFamily="@font/baloo2"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_primary"
            android:gravity="center"
            android:letterSpacing="0.04"
            android:alpha="0.0"
            android:elevation="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="44dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"/>

        <!-- ─── ROW 2: VS Computer + Online ─── -->
        <Button
            android:id="@+id/btnVsComputer"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:text="🤖  VS Computer"
            android:textSize="16sp"
            android:textColor="#1A1A35"
            android:fontFamily="@font/baloo2"
            android:background="@drawable/btn_gold"
            android:gravity="center"
            android:letterSpacing="0.03"
            android:alpha="0.0"
            android:elevation="6dp"
            app:layout_constraintTop_toBottomOf="@id/btnLocalGame"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnOnlineGame"
            android:layout_marginTop="14dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnOnlineGame"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:text="🌐  Online Game"
            android:textSize="16sp"
            android:fontFamily="@font/baloo2"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_primary"
            android:gravity="center"
            android:letterSpacing="0.03"
            android:alpha="0.0"
            android:elevation="6dp"
            app:layout_constraintTop_toTopOf="@id/btnVsComputer"
            app:layout_constraintStart_toEndOf="@id/btnVsComputer"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="24dp"/>

        <!-- ─── ROW 3: How to Play (wide) ─── -->
        <Button
            android:id="@+id/btnRules"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:text="📖  How to Play"
            android:textSize="16sp"
            android:fontFamily="@font/baloo2"
            android:textColor="#1A1A35"
            android:background="@drawable/btn_gold"
            android:gravity="center"
            android:letterSpacing="0.04"
            android:alpha="0.0"
            android:elevation="4dp"
            app:layout_constraintTop_toBottomOf="@id/btnVsComputer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="14dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"/>

        <TextView
            android:id="@+id/tvPrivacyPolicy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Privacy Policy"
            android:textSize="14sp"
            android:fontFamily="@font/baloo2"
            android:textColor="#9EDCFF"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:background="@drawable/tab_bg"
            android:alpha="0.0"
            app:layout_constraintBottom_toTopOf="@id/tvVersion"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="10dp"/>

        <!-- Version tag at bottom -->
        <TextView
            android:id="@+id/tvVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="v1.0"
            android:textSize="12sp"
            android:fontFamily="@font/baloo2"
            android:textColor="#66FFFFFF"
            android:letterSpacing="0.08"
            android:alpha="0.0"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="14dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ════════════════════════════════════════
         BANNER AD — GONE by default
    ════════════════════════════════════════ -->
    <com.google.android.gms.ads.AdView
        android:id="@+id/adView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        ads:adSize="BANNER"
        ads:adUnitId="@string/banner_ad_unit_id"/>

</LinearLayout>
