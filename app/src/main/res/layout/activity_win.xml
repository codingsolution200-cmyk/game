<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#0A0A1E"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🏆"
        android:textSize="80sp"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CONGRATULATIONS!"
        android:textColor="#6366F1"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="@font/baloo2"
        android:letterSpacing="0.15"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvWinner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Player 1 Wins!"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        android:fontFamily="@font/baloo2"
        android:gravity="center"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tvWinSub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔴 Player 1 • Winner"
        android:textColor="#AAAAAA"
        android:textSize="15sp"
        android:fontFamily="@font/baloo2"
        android:gravity="center"
        android:layout_marginBottom="20dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⭐ ⭐ ⭐"
        android:textSize="32sp"
        android:gravity="center"
        android:layout_marginBottom="28dp" />

    <View
        android:layout_width="120dp"
        android:layout_height="2dp"
        android:background="#6366F1"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btnPlayAgain"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="🔄  PLAY AGAIN"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="@font/baloo2"
        android:letterSpacing="0.08"
        android:backgroundTint="#6366F1"
        android:textColor="#FFFFFF"
        android:stateListAnimator="@null"
        android:elevation="4dp"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnHome"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="🏠  MAIN MENU"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="@font/baloo2"
        android:letterSpacing="0.08"
        android:backgroundTint="#1E1E50"
        android:textColor="#FFFFFF"
        android:stateListAnimator="@null"
        android:elevation="4dp" />

</LinearLayout>