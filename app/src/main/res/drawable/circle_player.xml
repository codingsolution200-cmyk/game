<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Outer glow ring -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#337C3AED"/>
            <padding
                android:left="-4dp"
                android:top="-4dp"
                android:right="-4dp"
                android:bottom="-4dp"/>
        </shape>
    </item>

    <!-- Main circle with radial gradient -->
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="200%"
                android:centerX="0.35"
                android:centerY="0.3"
                android:startColor="#9B6BF5"
                android:centerColor="#7C3AED"
                android:endColor="#5B21B6"/>
            <stroke android:width="2dp" android:color="#CCFFFFFF"/>
        </shape>
    </item>

</layer-list>