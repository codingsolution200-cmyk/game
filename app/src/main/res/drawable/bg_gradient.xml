<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base dark gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="160"
                android:startColor="#0D0A2E"
                android:centerColor="#130D3A"
                android:endColor="#1A1050"/>
        </shape>
    </item>
    <!-- Subtle radial glow at top-center -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="400%"
                android:centerX="0.5"
                android:centerY="0.1"
                android:startColor="#1A2255AA"
                android:endColor="#00000000"/>
        </shape>
    </item>
</layer-list>