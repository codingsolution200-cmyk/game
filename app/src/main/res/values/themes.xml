<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.SapSidi" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">#7C3AED</item>
        <item name="colorPrimaryDark">#5B21B6</item>
        <item name="colorAccent">#F59E0B</item>
        <item name="android:statusBarColor">#1A1A2E</item>
        <item name="android:navigationBarColor">#1A1A2E</item>
    </style>

    <!-- ✅ SIRF AA STYLE BADLYO -->

    <style name="Theme.SapSidi.Splash" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/splash_bg</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@color/splash_bg</item>
        <item name="android:navigationBarColor">@color/splash_bg</item>
        <item name="colorPrimary">#7C3AED</item>
        <item name="colorPrimaryDark">#5B21B6</item>
        <item name="colorAccent">#F59E0B</item>
    </style>

    <!-- Baaki sab same rakhyo -->
    <style name="Widget.SapSidi.Button.Primary" parent="Widget.AppCompat.Button">
        <item name="android:backgroundTint">#7C3AED</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="Widget.SapSidi.Button.Gold" parent="Widget.AppCompat.Button">
        <item name="android:backgroundTint">#F59E0B</item>
        <item name="android:textColor">#1A1A2E</item>
    </style>

    <style name="Widget.SapSidi.Button.Outline" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textColor">#7C3AED</item>
    </style>

    <style name="Widget.SapSidi.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">#1E1E3A</item>
        <item name="cardCornerRadius">12dp</item>
    </style>

    <style name="TextStyle.SapSidi.Title" parent="TextAppearance.AppCompat.Large">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextStyle.SapSidi.Subtitle" parent="TextAppearance.AppCompat.Medium">
        <item name="android:textColor">#B0B0CC</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="HintEditText" parent="Widget.AppCompat.EditText">
        <item name="android:textColorHint">#4B5563</item>
    </style>

    <style name="TextStyle.SapSidi.Gold" parent="TextAppearance.AppCompat.Medium">
        <item name="android:textColor">#F59E0B</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ExitDialogTheme" parent="Theme.MaterialComponents.Dialog.Alert">
        <item name="android:background">#1E1E3A</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="buttonBarPositiveButtonStyle">@style/ExitDialogPositiveBtn</item>
        <item name="buttonBarNegativeButtonStyle">@style/ExitDialogNegativeBtn</item>
    </style>

    <style name="ExitDialogPositiveBtn" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">#FF5252</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ExitDialogNegativeBtn" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">#69F0AE</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>